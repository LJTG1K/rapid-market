# RAPID Studio — copy to .env.local for dev, and set the same values in the
# Studio project's Vercel env vars for production. See SPEC.md § Credentials.

# Shared team password. Rotating it signs everyone out.
STUDIO_PASSWORD=
# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`).
STUDIO_SESSION_SECRET=

# Where drafts / publish history live: "local" (studio/.data/store.json, dev only)
# or "supabase". Defaults to local in dev and supabase on Vercel.
STUDIO_STORE=
# Supabase (same project as the site). Tables come from ../sql/studio_tables.sql.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub publishing. Without a token, Publish writes straight into this working
# copy's public/data/ instead of committing (dev only — refused on Vercel).
# Fine-grained PAT scoped to the repo below, Contents: read & write only.
GITHUB_TOKEN=
GITHUB_REPO=LJTG1K/rapid-market
GITHUB_BRANCH=main

# Live site, used read-only for product names (brand match counts).
STUDIO_SITE_URL=https://rapid.market

# Optional: deploy-status indicator for the *site's* Vercel project.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

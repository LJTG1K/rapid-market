{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "regions": ["sfo1"],
  "functions": {
    "pages/api/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "crons": [
    { "path": "/api/cron/brand-nudge", "schedule": "0 * * * *" },
    { "path": "/api/cron/wishlist-digest", "schedule": "0 14 * * 1" }
  ]
}
